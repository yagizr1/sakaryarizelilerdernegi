<h1 style="margin:0 0 12px;font-size:22px;line-height:1.35;color:#1e293b;font-weight:600;">{{title}}</h1>
{{#if memberName}}
<p style="margin:0 0 16px;font-size:15px;line-height:1.7;color:#475569;">
  Sayın <strong>{{memberName}}</strong>,
</p>
{{/if}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 8px;">
  <tr>
    <td style="background-color:#e3f2fd;border-left:4px solid #1976d2;border-radius:0 8px 8px 0;padding:18px 20px;">
      <p style="margin:0;font-size:15px;line-height:1.8;color:#1e293b;white-space:pre-line;">{{body}}</p>
    </td>
  </tr>
</table>
<p style="margin:16px 0 0;font-size:14px;line-height:1.7;color:#64748b;">
  Sorularınız için dernek yönetimi ile iletişime geçebilirsiniz.
</p>
