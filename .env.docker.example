# copy .env.docker.example .env.docker
# docker compose --env-file .env.docker up --build -d

POSTGRES_DB=dernek
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

JWT_SECRET=dernek-change-me-secret-min-32-chars
CLIENT_ORIGIN=http://localhost:8180

BACKEND_PORT=4100
WEB_PORT=8180

# E-posta (SMTP) — false iken mock (konsola yazar)
MAIL_ENABLED=false
MAIL_FROM_NAME=Dernek Yönetim
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# DernekCepte Sakarya org üye senkronu (tek yön: bu site → DernekCepte)
# DERNEKCEPTE_SYNC_ENABLED=true
# DERNEKCEPTE_SYNC_URL=https://dernekcepte.com/api/internal/sync/members
# DERNEKCEPTE_SYNC_SECRET=aynı-secret-dernekcepte-ile
# DERNEKCEPTE_SYNC_ORG_SLUG=sakarya-rizeliler-dernegi
